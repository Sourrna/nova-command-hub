# Cloudflare Access identity verification (Worker variables or local .dev.vars).
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-access-application-audience

# Server-side provider secrets. Keep out of VITE_* variables and browser storage.
OPENAI_API_KEY=
XAI_API_KEY=
NOTION_API_KEY=
GITHUB_API_KEY=
LOVABLE_API_KEY=
LINKEDIN_ACCESS_TOKEN=

# NOVA_DB is a Cloudflare D1 binding, not an environment variable.
